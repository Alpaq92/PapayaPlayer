# Warnings and sanitizers for our own targets only, never third-party ones
# (TECH-STACK.md step 11).
function(papaya_warning_flags out)
    if(CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        set(_flags /W4)
        if(PAPAYA_WERROR)
            list(APPEND _flags /WX)
        endif()
    else()
        set(_flags -Wall -Wextra -Wpedantic)
        if(PAPAYA_WERROR)
            list(APPEND _flags -Werror)
        endif()
    endif()
    set(${out} ${_flags} PARENT_SCOPE)
endfunction()

function(papaya_warnings target)
    papaya_warning_flags(_flags)
    target_compile_options(${target} PRIVATE ${_flags})
    if(WIN32)
        # The CRT's "use the _s variants" deprecations; we keep portable C.
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
    endif()
    if(PAPAYA_SANITIZE)
        list(JOIN PAPAYA_SANITIZE "," _san)
        target_compile_options(${target} PRIVATE -fsanitize=${_san} -fno-omit-frame-pointer)
    endif()
endfunction()
