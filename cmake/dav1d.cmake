# dav1d (AV1, BSD-2) built from its submodule with our own CMake, mirroring
# src/meson.build at the pinned tag (TECH-STACK.md wrapper-first policy: dav1d
# uses Meson, so its files stay untouched and the build lives here).
#
# x86-64 uses dav1d's NASM assembly when NASM is found. Other architectures
# build the C code only for now (correct, slower); dav1d's ARM assembly is a
# follow-up.

include(CheckIncludeFile)
include(CheckSymbolExists)

set(_d "${PROJECT_SOURCE_DIR}/third_party/dav1d")
set(_dgen "${CMAKE_BINARY_DIR}/dav1d")
file(READ "${_d}/meson.build" _dav1d_meson)
string(REGEX MATCH "version: '([0-9.]+)'" _ "${_dav1d_meson}")
set(DAV1D_VERSION "${CMAKE_MATCH_1}")

set(_dav1d_asm OFF)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    find_program(PAPAYA_NASM nasm)
    if(PAPAYA_NASM)
        set(CMAKE_ASM_NASM_COMPILER "${PAPAYA_NASM}")
        enable_language(ASM_NASM)
        set(_dav1d_asm ON)
    else()
        message(WARNING "NASM not found: dav1d is built without its x86 assembly (much slower)")
    endif()
endif()

# ---- config.h, vcs_version.h, config.asm ----------------------------------

macro(_dav1d_flag name value)
    if(${value})
        string(APPEND _dav1d_config "#define ${name} 1\n")
    else()
        string(APPEND _dav1d_config "#define ${name} 0\n")
    endif()
endmacro()

set(_dav1d_config "/* generated by cmake/dav1d.cmake */\n")
_dav1d_flag(CONFIG_8BPC ON)
_dav1d_flag(CONFIG_16BPC ON)
_dav1d_flag(HAVE_ASM _dav1d_asm)
_dav1d_flag(TRIM_DSP_FUNCTIONS ON)
_dav1d_flag(CONFIG_LOG ON)
_dav1d_flag(ENDIANNESS_BIG OFF)
set(_x86 OFF)
set(_x86_64 OFF)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(_x86 ON)
    set(_x86_64 ON)
endif()
set(_aarch64 OFF)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
    set(_aarch64 ON)
endif()
_dav1d_flag(ARCH_X86 _x86)
_dav1d_flag(ARCH_X86_64 _x86_64)
_dav1d_flag(ARCH_X86_32 OFF)
_dav1d_flag(ARCH_AARCH64 _aarch64)
foreach(_a ARCH_ARM ARCH_PPC64LE ARCH_RISCV ARCH_RV32 ARCH_RV64 ARCH_LOONGARCH
           ARCH_LOONGARCH32 ARCH_LOONGARCH64)
    _dav1d_flag(${_a} OFF)
endforeach()
if(APPLE)
    _dav1d_flag(PREFIX ON)
endif()

if(WIN32)
    string(APPEND _dav1d_config
        "#define _WIN32_WINNT 0x0601\n#define UNICODE 1\n#define _UNICODE 1\n"
        "#define _CRT_DECLARE_NONSTDC_NAMES 1\n#define fseeko _fseeki64\n#define ftello _ftelli64\n")
    foreach(_f HAVE_CLOCK_GETTIME HAVE_SIGACTION HAVE_POSIX_MEMALIGN HAVE_MEMALIGN HAVE_ALIGNED_ALLOC
               HAVE_DLSYM HAVE_UNISTD_H HAVE_PTHREAD_NP_H HAVE_GETAUXVAL HAVE_ELF_AUX_INFO
               HAVE_PTHREAD_GETAFFINITY_NP HAVE_PTHREAD_SETAFFINITY_NP HAVE_PTHREAD_SETNAME_NP
               HAVE_PTHREAD_SET_NAME_NP)
        _dav1d_flag(${_f} OFF)
    endforeach()
    _dav1d_flag(HAVE_SYS_TYPES_H ON)
    _dav1d_flag(HAVE_IO_H ON)
else()
    set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
    set(CMAKE_REQUIRED_LIBRARIES Threads::Threads ${CMAKE_DL_LIBS})
    check_symbol_exists(clock_gettime time.h _have_clock_gettime)
    check_symbol_exists(sigaction signal.h _have_sigaction)
    check_symbol_exists(posix_memalign stdlib.h _have_posix_memalign)
    check_symbol_exists(memalign malloc.h _have_memalign)
    check_symbol_exists(aligned_alloc stdlib.h _have_aligned_alloc)
    check_symbol_exists(dlsym dlfcn.h _have_dlsym)
    check_symbol_exists(getauxval sys/auxv.h _have_getauxval)
    check_symbol_exists(elf_aux_info sys/auxv.h _have_elf_aux_info)
    check_include_file(pthread_np.h _have_pthread_np_h)
    if(_have_pthread_np_h)
        set(_np_headers "pthread.h;pthread_np.h")
    else()
        set(_np_headers "pthread.h")
    endif()
    check_symbol_exists(pthread_getaffinity_np "${_np_headers}" _have_getaffinity)
    check_symbol_exists(pthread_setaffinity_np "${_np_headers}" _have_setaffinity)
    check_symbol_exists(pthread_setname_np "${_np_headers}" _have_setname_np)
    check_symbol_exists(pthread_set_name_np "${_np_headers}" _have_set_name_np)
    unset(CMAKE_REQUIRED_DEFINITIONS)
    unset(CMAKE_REQUIRED_LIBRARIES)
    _dav1d_flag(HAVE_CLOCK_GETTIME _have_clock_gettime)
    _dav1d_flag(HAVE_SIGACTION _have_sigaction)
    _dav1d_flag(HAVE_POSIX_MEMALIGN _have_posix_memalign)
    _dav1d_flag(HAVE_MEMALIGN _have_memalign)
    _dav1d_flag(HAVE_ALIGNED_ALLOC _have_aligned_alloc)
    _dav1d_flag(HAVE_DLSYM _have_dlsym)
    _dav1d_flag(HAVE_GETAUXVAL _have_getauxval)
    _dav1d_flag(HAVE_ELF_AUX_INFO _have_elf_aux_info)
    _dav1d_flag(HAVE_PTHREAD_NP_H _have_pthread_np_h)
    _dav1d_flag(HAVE_PTHREAD_GETAFFINITY_NP _have_getaffinity)
    _dav1d_flag(HAVE_PTHREAD_SETAFFINITY_NP _have_setaffinity)
    _dav1d_flag(HAVE_PTHREAD_SETNAME_NP _have_setname_np)
    _dav1d_flag(HAVE_PTHREAD_SET_NAME_NP _have_set_name_np)
    _dav1d_flag(HAVE_SYS_TYPES_H ON)
    _dav1d_flag(HAVE_UNISTD_H ON)
    _dav1d_flag(HAVE_IO_H OFF)
endif()
_dav1d_flag(HAVE_C11_GENERIC ON)
file(CONFIGURE OUTPUT "${_dgen}/config.h" CONTENT "${_dav1d_config}")
file(CONFIGURE OUTPUT "${_dgen}/vcs_version.h"
     CONTENT "/* generated by cmake/dav1d.cmake */\n#define DAV1D_VERSION \"${DAV1D_VERSION}\"\n")
if(_dav1d_asm)
    set(_asm_cfg "%define private_prefix dav1d\n%define ARCH_X86_64 1\n%define ARCH_X86_32 0\n"
                 "%define PIC 1\n%define STACK_ALIGNMENT 16\n%define FORCE_VEX_ENCODING 0\n")
    if(APPLE)
        string(APPEND _asm_cfg "%define PREFIX 1\n")
    endif()
    file(CONFIGURE OUTPUT "${_dgen}/config.asm" CONTENT "${_asm_cfg}")
endif()

# ---- sources (src/meson.build) ----------------------------------------------

set(_dav1d_sources cdf.c cpu.c ctx.c data.c decode.c dequant_tables.c getbits.c intra_edge.c
    itx_1d.c lf_mask.c lib.c log.c mem.c msac.c obu.c pal.c picture.c qm.c ref.c refmvs.c
    scan.c tables.c thread_task.c warpmv.c wedge.c)
set(_dav1d_tmpl cdef_apply_tmpl.c cdef_tmpl.c fg_apply_tmpl.c filmgrain_tmpl.c
    ipred_prepare_tmpl.c ipred_tmpl.c itx_tmpl.c lf_apply_tmpl.c loopfilter_tmpl.c
    looprestoration_tmpl.c lr_apply_tmpl.c mc_tmpl.c recon_tmpl.c)
list(TRANSFORM _dav1d_sources PREPEND "${_d}/src/")
list(TRANSFORM _dav1d_tmpl PREPEND "${_d}/src/")
if(WIN32)
    list(APPEND _dav1d_sources "${_d}/src/win32/thread.c")
endif()
if(_x86)
    list(APPEND _dav1d_sources "${_d}/src/x86/cpu.c")
elseif(_aarch64)
    list(APPEND _dav1d_sources "${_d}/src/arm/cpu.c")
endif()

set(_dav1d_includes "${_dgen}" "${_d}" "${_d}/include/dav1d" "${_d}/include")
set(_dav1d_defs "")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    list(APPEND _dav1d_defs _GNU_SOURCE)
endif()

function(_dav1d_quiet target)
    # Third-party code: no warnings of ours, and theirs are not our errors.
    if(CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
        target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:C>:/W0>)
    else()
        target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:C>:-w>)
    endif()
endfunction()

foreach(_bpc 8 16)
    add_library(dav1d_bitdepth_${_bpc} OBJECT ${_dav1d_tmpl})
    target_include_directories(dav1d_bitdepth_${_bpc} PRIVATE ${_dav1d_includes})
    target_compile_definitions(dav1d_bitdepth_${_bpc} PRIVATE BITDEPTH=${_bpc} ${_dav1d_defs})
    set_target_properties(dav1d_bitdepth_${_bpc} PROPERTIES C_VISIBILITY_PRESET hidden)
    _dav1d_quiet(dav1d_bitdepth_${_bpc})
endforeach()

set(_dav1d_asm_sources "")
if(_dav1d_asm)
    foreach(_f cpuid msac pal refmvs itx_avx512 cdef_avx2 itx_avx2 cdef_sse itx_sse
               cdef_avx512 filmgrain_avx512 ipred_avx512 loopfilter_avx512 looprestoration_avx512
               mc_avx512 filmgrain_avx2 ipred_avx2 loopfilter_avx2 looprestoration_avx2 mc_avx2
               filmgrain_sse ipred_sse loopfilter_sse looprestoration_sse mc_sse
               cdef16_avx512 filmgrain16_avx512 ipred16_avx512 itx16_avx512 loopfilter16_avx512
               looprestoration16_avx512 mc16_avx512 cdef16_avx2 filmgrain16_avx2 ipred16_avx2
               itx16_avx2 loopfilter16_avx2 looprestoration16_avx2 mc16_avx2 cdef16_sse
               filmgrain16_sse ipred16_sse itx16_sse loopfilter16_sse looprestoration16_sse mc16_sse)
        list(APPEND _dav1d_asm_sources "${_d}/src/x86/${_f}.asm")
    endforeach()
    set_source_files_properties(${_dav1d_asm_sources} PROPERTIES
        INCLUDE_DIRECTORIES "${_d}/src/;${_dgen}/")
endif()

add_library(dav1d ${_dav1d_sources} ${_dav1d_asm_sources}
            $<TARGET_OBJECTS:dav1d_bitdepth_8> $<TARGET_OBJECTS:dav1d_bitdepth_16>)
target_include_directories(dav1d PRIVATE ${_dav1d_includes})
target_include_directories(dav1d PUBLIC "${_d}/include")
target_compile_definitions(dav1d PRIVATE ${_dav1d_defs})
if(WIN32 AND BUILD_SHARED_LIBS)
    target_compile_definitions(dav1d PRIVATE DAV1D_BUILDING_DLL)
endif()
set_target_properties(dav1d PROPERTIES C_VISIBILITY_PRESET hidden)
_dav1d_quiet(dav1d)
if(UNIX)
    target_link_libraries(dav1d PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
endif()
