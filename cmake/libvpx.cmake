# libvpx (VP8 / VP9, BSD-3) built from its submodule with our own CMake
# (TECH-STACK.md wrapper-first policy: libvpx uses its own configure script,
# so its files stay untouched and the build lives here).
#
# Decoders only, VP9 high bit depth on (10-bit HDR). The configuration header
# is written from the feature lists in libvpx's configure; the source lists are
# read from its .mk files by a small evaluator; the run-time CPU dispatch
# headers come from its own rtcd.pl (Perl). This first version builds the C
# code ("generic"); the x86 / ARM SIMD paths are a follow-up.

find_package(Perl REQUIRED)

set(_v "${PROJECT_SOURCE_DIR}/third_party/libvpx")
set(_vgen "${CMAKE_BINARY_DIR}/libvpx")
file(MAKE_DIRECTORY "${_vgen}")

# ---- feature lists from configure -------------------------------------------

file(READ "${_v}/configure" _vpx_configure)

# The words of NAME="..." in configure, with ${OTHER} references expanded.
function(_vpx_list name out)
    string(REGEX MATCH "\n${name}=\"([^\"]*)\"" _ "${_vpx_configure}")
    set(_body "${CMAKE_MATCH_1}")
    string(REGEX REPLACE "#[^\n]*" "" _body "${_body}")
    string(REGEX REPLACE "[ \t\n]+" ";" _body "${_body}")
    set(_words "")
    foreach(_w ${_body})
        if(_w MATCHES "^\\$\\{([A-Z0-9_]+)\\}$")
            _vpx_list(${CMAKE_MATCH_1} _sub)
            list(APPEND _words ${_sub})
        elseif(_w)
            list(APPEND _words ${_w})
        endif()
    endforeach()
    set(${out} ${_words} PARENT_SCOPE)
endfunction()

_vpx_list(ARCH_LIST _vpx_arch_list)
_vpx_list(HAVE_LIST _vpx_have_list)
_vpx_list(CONFIG_LIST _vpx_config_list)

# Everything not listed here is "no".
set(_vpx_yes CONFIG_VP8 CONFIG_VP9 CONFIG_VP8_DECODER CONFIG_VP9_DECODER CONFIG_DECODERS
    CONFIG_MULTITHREAD CONFIG_VP9_HIGHBITDEPTH CONFIG_OS_SUPPORT CONFIG_PIC CONFIG_STATIC
    HAVE_VPX_PORTS)
# x86-64 with NASM: libvpx's SSE2...AVX-512 code, chosen at run time by CPU.
# Elsewhere (ARM for now) the generic C build, without VPX_ARCH_* so the port
# helpers' assembly is not pulled in.
set(_vpx_rtcd_arch generic)
set(_vpx_x86 OFF)
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$" AND PAPAYA_NASM)
    set(_vpx_x86 ON)
    set(_vpx_rtcd_arch x86_64)
    list(APPEND _vpx_yes VPX_ARCH_X86_64 HAVE_X86_ASM HAVE_MMX HAVE_SSE HAVE_SSE2 HAVE_SSE3 HAVE_SSSE3
         HAVE_SSE4_1 HAVE_AVX HAVE_AVX2 HAVE_AVX512 CONFIG_RUNTIME_CPU_DETECT)
endif()
if(UNIX)
    list(APPEND _vpx_yes HAVE_PTHREAD_H HAVE_UNISTD_H CONFIG_GCC)
endif()

function(_vpx_value name out)
    if(name IN_LIST _vpx_yes)
        set(${out} "yes" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

# ---- vpx_config.h, the rtcd config, vpx_version.h, vpx_config.c --------------

string(CONCAT _h "/* generated by cmake/libvpx.cmake */\n#ifndef VPX_CONFIG_H\n#define VPX_CONFIG_H\n"
       "#define RESTRICT\n#define INLINE inline\n")
set(_mk "")
foreach(_pair "VPX_ARCH;_vpx_arch_list" "HAVE;_vpx_have_list" "CONFIG;_vpx_config_list")
    list(GET _pair 0 _prefix)
    list(GET _pair 1 _listvar)
    foreach(_name ${${_listvar}})
        string(TOUPPER "${_prefix}_${_name}" _up)
        if(_up IN_LIST _vpx_yes)
            string(APPEND _h "#define ${_up} 1\n")
            string(APPEND _mk "${_up}=yes\n")
        else()
            string(APPEND _h "#define ${_up} 0\n")
        endif()
    endforeach()
endforeach()
string(APPEND _h "#endif\n")
papaya_generate(OUTPUT "${_vgen}/vpx_config.h" CONTENT "${_h}")
# vpx_config.asm: the same 0 / 1 values as "NAME equ VALUE" (libs.mk does this
# with grep and awk).
string(REGEX MATCHALL "#define [A-Z0-9_]+ [01]" _vpx_defs "${_h}")
set(_asm "")
foreach(_d ${_vpx_defs})
    string(REGEX REPLACE "#define ([A-Z0-9_]+) ([01])" "\\1 equ \\2\n" _line "${_d}")
    string(APPEND _asm "${_line}")
endforeach()
papaya_generate(OUTPUT "${_vgen}/vpx_config.asm" CONTENT "${_asm}")
papaya_generate(OUTPUT "${_vgen}/rtcd_config.mk" CONTENT "${_mk}")
papaya_generate(OUTPUT "${_vgen}/vpx_config.c"
     CONTENT "#include \"vpx/vpx_codec.h\"\nconst char *vpx_codec_build_config(void) { return \"PapayaPlayer\"; }\n")

file(READ "${_v}/CHANGELOG" _vpx_changelog LIMIT 400)
string(REGEX MATCH "v([0-9]+)\\.([0-9]+)\\.([0-9]+)" _ "${_vpx_changelog}")
set(_vmaj ${CMAKE_MATCH_1})
set(_vmin ${CMAKE_MATCH_2})
set(_vpat ${CMAKE_MATCH_3})
papaya_generate(OUTPUT "${_vgen}/vpx_version.h" CONTENT
"#define VERSION_MAJOR ${_vmaj}
#define VERSION_MINOR ${_vmin}
#define VERSION_PATCH ${_vpat}
#define VERSION_EXTRA \"\"
#define VERSION_PACKED ((VERSION_MAJOR << 16) | (VERSION_MINOR << 8) | (VERSION_PATCH))
#define VERSION_STRING_NOSP \"v${_vmaj}.${_vmin}.${_vpat}\"
#define VERSION_STRING \" v${_vmaj}.${_vmin}.${_vpat}\"
")

foreach(_r "vp8_rtcd;vp8/common/rtcd_defs.pl" "vp9_rtcd;vp9/common/vp9_rtcd_defs.pl"
           "vpx_dsp_rtcd;vpx_dsp/vpx_dsp_rtcd_defs.pl" "vpx_scale_rtcd;vpx_scale/vpx_scale_rtcd.pl")
    list(GET _r 0 _sym)
    list(GET _r 1 _defs)
    if(NOT EXISTS "${_vgen}/${_sym}.h" OR NOT _vpx_rtcd_arch STREQUAL "${PAPAYA_VPX_RTCD_ARCH}"
       OR "${_v}/${_defs}" IS_NEWER_THAN "${_vgen}/${_sym}.h"
       OR "${_vgen}/rtcd_config.mk" IS_NEWER_THAN "${_vgen}/${_sym}.h")
        execute_process(
            COMMAND "${PERL_EXECUTABLE}" "${_v}/build/make/rtcd.pl" --arch=${_vpx_rtcd_arch} --sym=${_sym}
                    "--config=${_vgen}/rtcd_config.mk" "${_v}/${_defs}"
            OUTPUT_FILE "${_vgen}/${_sym}.h"
            RESULT_VARIABLE _rc)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "libvpx: rtcd.pl failed for ${_defs}")
        endif()
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_v}/${_defs}")
endforeach()

set(PAPAYA_VPX_RTCD_ARCH "${_vpx_rtcd_arch}" CACHE INTERNAL "")

# ---- source lists from the .mk files ----------------------------------------

# Expands $(VAR) (yes or empty) and $(filter yes,...) in text.
function(_vpx_expand text out)
    set(_t "${text}")
    while(_t MATCHES "\\$\\(([A-Z0-9_]+)\\)")
        _vpx_value(${CMAKE_MATCH_1} _val)
        string(REPLACE "$(${CMAKE_MATCH_1})" "${_val}" _t "${_t}")
    endwhile()
    while(_t MATCHES "\\$\\(filter yes,([^)]*)\\)")
        set(_inner "${CMAKE_MATCH_1}")
        if(_inner MATCHES "yes")
            string(REPLACE "$(filter yes,${_inner})" "yes" _t "${_t}")
        else()
            string(REPLACE "$(filter yes,${_inner})" "" _t "${_t}")
        endif()
    endwhile()
    set(${out} "${_t}" PARENT_SCOPE)
endfunction()

# Appends to out the .c files of a .mk that are enabled ("..._SRCS-yes"),
# relative paths resolved against dir, less the _SRCS_REMOVE-yes ones.
function(_vpx_mk_sources mk dir out)
    file(STRINGS "${_v}/${mk}" _lines)
    set(_active TRUE)
    set(_stack "")
    set(_files "")
    set(_remove "")
    foreach(_line IN LISTS _lines)
        string(REGEX REPLACE "#.*$" "" _line "${_line}")
        string(STRIP "${_line}" _line)
        if(_line MATCHES "^(ifeq|ifneq)[ \t]*\\((.*)\\)$")
            set(_kind ${CMAKE_MATCH_1})
            _vpx_expand("${CMAKE_MATCH_2}" _cond)
            string(REPLACE " " "" _cond "${_cond}")
            string(FIND "${_cond}" "," _comma)
            string(SUBSTRING "${_cond}" 0 ${_comma} _a)
            math(EXPR _comma "${_comma} + 1")
            string(SUBSTRING "${_cond}" ${_comma} -1 _b)
            if((_kind STREQUAL "ifeq" AND _a STREQUAL _b) OR (_kind STREQUAL "ifneq" AND NOT _a STREQUAL _b))
                set(_c TRUE)
            else()
                set(_c FALSE)
            endif()
            list(APPEND _stack "${_active}")
            if(_active AND _c)
                set(_active TRUE)
            else()
                set(_active FALSE)
            endif()
            list(APPEND _stack "${_c}")
        elseif(_line STREQUAL "else")
            list(POP_BACK _stack _c)
            list(GET _stack -1 _outer)
            list(APPEND _stack "NOT")
            if(_outer AND NOT _c)
                set(_active TRUE)
            else()
                set(_active FALSE)
            endif()
        elseif(_line MATCHES "^endif")
            list(POP_BACK _stack _c)
            list(POP_BACK _stack _active)
        elseif(_active AND _line MATCHES "^[A-Z0-9_]+_SRCS(_REMOVE)?-([^ \t+:=]+)[ \t]*[+:]?=[ \t]*(.*)$")
            set(_is_remove "${CMAKE_MATCH_1}")
            _vpx_expand("${CMAKE_MATCH_2}" _when)
            set(_what "${CMAKE_MATCH_3}")
            if(_when STREQUAL "yes" AND _what MATCHES "^[A-Za-z0-9_./]+\\.(c|asm)$")
                if(_is_remove)
                    list(APPEND _remove "${dir}/${_what}")
                else()
                    list(APPEND _files "${dir}/${_what}")
                endif()
            endif()
        endif()
    endforeach()
    if(_remove)
        list(REMOVE_ITEM _files ${_remove})
    endif()
    set(${out} ${${out}} ${_files} PARENT_SCOPE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_v}/${mk}")
endfunction()

set(_vpx_sources "")
_vpx_mk_sources(vpx/vpx_codec.mk "${_v}/vpx" _vpx_sources)
_vpx_mk_sources(vpx_mem/vpx_mem.mk "${_v}/vpx_mem" _vpx_sources)
_vpx_mk_sources(vpx_scale/vpx_scale.mk "${_v}/vpx_scale" _vpx_sources)
_vpx_mk_sources(vpx_ports/vpx_ports.mk "${_v}/vpx_ports" _vpx_sources)
_vpx_mk_sources(vpx_dsp/vpx_dsp.mk "${_v}/vpx_dsp" _vpx_sources)
_vpx_mk_sources(vpx_util/vpx_util.mk "${_v}/vpx_util" _vpx_sources)
_vpx_mk_sources(vp8/vp8_common.mk "${_v}/vp8" _vpx_sources)
_vpx_mk_sources(vp8/vp8dx.mk "${_v}/vp8" _vpx_sources)
_vpx_mk_sources(vp9/vp9_common.mk "${_v}/vp9" _vpx_sources)
_vpx_mk_sources(vp9/vp9dx.mk "${_v}/vp9" _vpx_sources)
list(REMOVE_DUPLICATES _vpx_sources)
if(_vpx_x86 AND WIN32)
    # Listed under CONFIG_MSVS in vpx_ports.mk; clang-cl defines _MSC_VER too.
    list(APPEND _vpx_sources "${_v}/vpx_ports/float_control_word.asm")
endif()
if(_vpx_x86)
    # The ISA of each intrinsics file, as libvpx's Makefile gives them.
    foreach(_isa "mmx:-mmmx" "sse2:-msse2" "sse3:-msse3" "ssse3:-mssse3" "sse4:-msse4.1"
                 "avx:-mavx" "avx2:-mavx2"
                 "avx512:-mavx512f;-mavx512cd;-mavx512bw;-mavx512dq;-mavx512vl")
        string(REGEX MATCH "^[^:]+" _sfx "${_isa}")
        string(REGEX REPLACE "^[^:]+:" "" _flags "${_isa}")
        foreach(_f ${_vpx_sources})
            if(_f MATCHES "_${_sfx}\\.c$")
                set_source_files_properties("${_f}" PROPERTIES COMPILE_OPTIONS "${_flags}")
            endif()
        endforeach()
    endforeach()
    set(_vpx_asm ${_vpx_sources})
    list(FILTER _vpx_asm INCLUDE REGEX "\\.asm$")
    set(_asm_inc "${_vgen}/" "${_v}/")
    set_source_files_properties(${_vpx_asm} PROPERTIES INCLUDE_DIRECTORIES "${_asm_inc}")
    if(APPLE)
        set_source_files_properties(${_vpx_asm} PROPERTIES COMPILE_DEFINITIONS PREFIX)
    endif()
endif()

add_library(vpx ${_vpx_sources} "${_vgen}/vpx_config.c")
target_include_directories(vpx PRIVATE "${_vgen}" "${_v}")
target_include_directories(vpx PUBLIC "${_v}")
set_target_properties(vpx PROPERTIES
    C_VISIBILITY_PRESET default
    WINDOWS_EXPORT_ALL_SYMBOLS ON)  # libvpx has no export macros
if(CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    target_compile_options(vpx PRIVATE $<$<COMPILE_LANGUAGE:C>:/W0>)
    target_compile_definitions(vpx PRIVATE _CRT_SECURE_NO_WARNINGS)
else()
    target_compile_options(vpx PRIVATE $<$<COMPILE_LANGUAGE:C>:-w>)
endif()
if(UNIX)
    target_link_libraries(vpx PRIVATE Threads::Threads m)
endif()
