# Our code only; third_party/ is never linted.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-signed-bitwise,
  cert-err33-c,
  clang-analyzer-*,
  misc-redundant-expression,
  performance-*,
  portability-*
WarningsAsErrors: '*'
HeaderFilterRegex: '(papaya|app|tests)/'
